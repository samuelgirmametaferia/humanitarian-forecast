# Public browser configuration (safe to expose)
VITE_API_BASE_URL=/api
VITE_MAP_STYLE_URL=
VITE_PROVIDER_MODE=production

# Server-only configuration (never prefix with VITE_)
HF_PROVIDER_MODE=demo
HF_DATABASE_URL=
HF_INGEST_HMAC_SECRET=
HF_CRON_SECRET=
# Vercel's native cron signer reads this exact name. Set it to the same value
# as HF_CRON_SECRET when using Vercel.
CRON_SECRET=
HF_ALLOWED_ORIGINS=https://your-hf-domain.example
HF_UPSTASH_REDIS_REST_URL=
HF_UPSTASH_REDIS_REST_TOKEN=
# HF_MODEL_DIR can override the bundled parity-validated artifact path.
HF_MODEL_DIR=

# GitHub Actions only
GROQ_API_KEY=
HF_INGEST_URL=https://your-hf-domain.example/api/v1/ingest
HF_INGEST_HMAC_SECRET=
HF_RECONCILE_URL=https://your-hf-domain.example/api/v1/learn/reconcile
HF_CRON_SECRET=
