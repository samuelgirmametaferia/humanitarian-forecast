{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanitarian-forecaster.org/contracts/ingest-envelope.v1.schema.json",
  "title": "HF signed daily ingest envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "generatedAt", "featurePayload", "sourceSummary"],
  "properties": {
    "schemaVersion": {"const": "ingest-envelope.v1"},
    "runId": {"type": "string", "pattern": "^[a-zA-Z0-9._:-]{8,100}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "featurePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "country", "conflictId", "conflictLabel", "anchor", "observationCutoff", "horizonDays", "events", "candidates"],
      "properties": {
        "schemaVersion": {"const": "feature-contract.v1"},
        "country": {"const": "Ethiopia"},
        "conflictId": {"type": "string", "maxLength": 100},
        "conflictLabel": {"type": "string", "minLength": 1, "maxLength": 100},
        "anchor": {
          "type": "object", "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": {"type": "number", "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180}
          }
        },
        "observationCutoff": {"type": "string", "format": "date-time"},
        "horizonDays": {"type": "integer", "minimum": 1, "maximum": 30},
        "events": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "array", "minItems": 19, "maxItems": 19, "items": {"type": "number"}}},
        "candidates": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"$ref": "#/$defs/candidate"}}
      }
    },
    "sourceSummary": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "forecast-snapshot.v1.schema.json#/$defs/source"}}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "valid", "eastKm", "northKm", "features"],
      "properties": {
        "id": {"type": "string", "maxLength": 80},
        "valid": {"type": "boolean"},
        "eastKm": {"type": "number", "minimum": -2000, "maximum": 2000},
        "northKm": {"type": "number", "minimum": -2000, "maximum": 2000},
        "features": {"type": "array", "minItems": 37, "maxItems": 37, "items": {"type": "number"}}
      }
    }
  }
}
