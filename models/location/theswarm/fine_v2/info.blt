{
  "model": "theswarm_fine_v2 (v11_spillover+v11_lambdarank ensemble)",
  "input": "64 cutoff-safe candidates (32 conflict-frequency sites + 32 recent cross-conflict event sites), 37 features incl. ReliefWeb mentions, UCDP windows, spillover activity, elevation/ruggedness",
  "blend": "mean of softmax over the listed checkpoints",
  "zone_selection": {
    "method": "greedy spatial-spread discount",
    "spread_km": 30.0
  },
  "ethiopia_metrics": {
    "validation": {
      "samples": 785,
      "within_20km_at_top1": 0.134,
      "median_error_km": 124.9,
      "plain_within_20km_at_top3": 0.225,
      "plain_within_20km_at_top5": 0.311,
      "diverse_within_20km_at_top5": 0.33,
      "plain_within_20km_at_top10": 0.395,
      "diverse_within_20km_at_top10": 0.443,
      "oracle_within_20km": 0.673,
      "probability_mass_within_20km": 0.082
    },
    "development": {
      "samples": 968,
      "within_20km_at_top1": 0.042,
      "median_error_km": 201.3,
      "plain_within_20km_at_top3": 0.106,
      "plain_within_20km_at_top5": 0.152,
      "diverse_within_20km_at_top5": 0.158,
      "plain_within_20km_at_top10": 0.243,
      "diverse_within_20km_at_top10": 0.248,
      "oracle_within_20km": 0.553,
      "probability_mass_within_20km": 0.03
    }
  },
  "caveats": [
    "oracle_within_20km is the coverage ceiling of the candidate pool, not model accuracy",
    "roughly half of Ethiopia validation targets are geolocated by UCDP to a named-place radius (where_prec>=2), so 20 km hits on those rows are partly coordinate noise",
    "Coarse humanitarian early-warning research signal, not a tactical coordinate forecast"
  ]
}
